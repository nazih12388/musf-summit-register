rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Reference collections
    match /classes/{id} { allow read: if true; allow write: if true; }
    match /teams/{id} { allow read: if true; allow write: if true; }
    match /sections/{id} { allow read: if true; allow write: if true; }
    match /fields/{id} { allow read: if true; allow write: if true; }
    match /categories/{id} { allow read: if true; allow write: if true; }
    match /summits/{id} { allow read: if true; allow write: if true; }
    match /programs/{id} { allow read: if true; allow write: if true; }
    match /programLibrary/{id} { allow read: if true; allow write: if true; }
    match /notices/{id} { allow read: if true; allow write: if true; }
    match /settings/{id} { allow read: if true; allow write: if true; }
    match /certificates/{id} { allow read: if true; allow write: if true; }
    match /reportHistory/{id} { allow read: if true; allow write: if true; }
    match /users/{userId} { allow read: if true; allow write: if true; }
    match /students/{studentId} { allow read: if true; allow write: if true; }
    match /entries/{entryId} { allow read: if true; allow write: if true; }
    match /marks/{markId} { allow read: if true; allow write: if true; }
    match /attendance/{attendanceId} { allow read: if true; allow write: if true; }
    match /notifications/{notifId} { allow read: if true; allow write: if true; }
    match /auditLogs/{logId} { allow read: if true; allow write: if true; }
    match /judges/{judgeId} { allow read: if true; allow write: if true; }

    // Fallback allows migration & non-blocking operational continuity across all devices
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
