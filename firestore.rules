rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Enforcement
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isJudge() {
      return isAuthenticated() && (
        request.auth.token.role == 'judge' ||
        getUserData().role == 'judge'
      );
    }

    function isLeader() {
      return isAuthenticated() && (
        request.auth.token.role == 'leader' ||
        getUserData().role == 'leader'
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        request.auth.token.role == 'student' ||
        getUserData().role == 'student'
      );
    }

    // Helper to get leader's teamId
    function getLeaderTeamId() {
      return getUserData().teamId;
    }

    // 1. Settings Collection
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Summits Collection
    match /summits/{summitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Classes & Teams
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Teams: Admin manages; leaders can only read
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Fields (Academic Program Groups)
    match /fields/{fieldId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Master Programs Library
    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Students Collection
    // Admin: full access
    // Leader: can view ONLY members belonging to their own team (never other teams)
    // Student: can view only their own profile
    match /students/{studentId} {
      allow read: if isAdmin() ||
        (isLeader() && resource.data.teamId == getLeaderTeamId()) ||
        (isStudent() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    match /archived_students/{studentId} {
      allow read, write: if isAdmin();
    }

    // 7. Entries (Nominations)
    // Admin: full control (add, edit, override, remove any team's entry)
    // Leader: can create/remove entries ONLY for students belonging to their own team,
    // provided the summit registration is not locked. Cross-team nominations are strictly prohibited.
    match /entries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // Leader nomination
      allow create: if isLeader() &&
        request.resource.data.teamId == getLeaderTeamId() &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teamId == getLeaderTeamId() &&
        get(/databases/$(database)/documents/summits/$(request.resource.data.summitId)).data.isRegistrationLocked != true;
        
      // Leader removal of nomination prior to registration lock
      allow delete: if isLeader() &&
        resource.data.teamId == getLeaderTeamId() &&
        get(/databases/$(database)/documents/summits/$(resource.data.summitId)).data.isRegistrationLocked != true;
    }

    // 8. Marks Collection
    // Admin: full access (create, edit, override, delete)
    // Judge: can enter marks only for assigned programs when not locked
    // Leader: can submit marks only for own team members when allowLeaderMarkEntry is enabled
    // Student: can read marks only after results are published
    match /marks/{markId} {
      allow read: if isAdmin() || isJudge() || (
        get(/databases/$(database)/documents/programs/$(resource.data.programId)).data.status == 'published'
      );

      // Judge entry
      allow create, update: if isAdmin() || (
        isJudge() &&
        request.resource.data.enteredBy == request.auth.uid &&
        request.resource.data.marks >= 0 && request.resource.data.marks <= 10 &&
        get(/databases/$(database)/documents/programs/$(request.resource.data.programId)).data.status != 'locked'
      ) || (
        // Team Leader upload (submit-once for own team members)
        isLeader() &&
        request.resource.data.sourceRole == 'leader' &&
        request.resource.data.marks >= 0 && request.resource.data.marks <= 10 &&
        request.resource.data.teamId == getLeaderTeamId() &&
        get(/databases/$(database)/documents/programs/$(request.resource.data.programId)).data.allowLeaderMarkEntry == true
      );

      allow delete: if isAdmin();
    }

    // 9. Attendance Collection (START, MID, END Sessions)
    // Admin: full read/write
    // Leader: can record/update attendance ONLY for own team members if session is unlocked
    // Student: can read own attendance records
    match /attendance/{attId} {
      allow read: if isAdmin() ||
        (isLeader() && resource.data.teamId == getLeaderTeamId()) ||
        (isStudent() && resource.data.studentId == request.auth.uid);

      allow create, update: if isAdmin() || (
        isLeader() &&
        request.resource.data.teamId == getLeaderTeamId() &&
        resource.data.locked != true &&
        request.resource.data.locked != true
      );

      allow delete: if isAdmin();
    }

    // 10. Notices
    match /notices/{noticeId} {
      allow read: if isAuthenticated() && (
        resource.data.status == 'published' || isAdmin()
      );
      allow write: if isAdmin();
    }

    // 11. Notifications
    // Each user reads their own notifications. Leaders can send peer notifications to co-leader & admin.
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin() || isLeader();
      allow delete: if isAdmin();
    }

    // 12. Audit Logs (Strictly Immutable, Append-Only)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
