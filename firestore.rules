rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@musf.app' ||
        (userDocExists() && getUserData().role == 'admin') ||
        request.auth.token.admin == true
      );
    }

    function isLeader() {
      return isAuthenticated() && (
        (userDocExists() && getUserData().role == 'leader') ||
        request.auth.token.role == 'leader'
      );
    }

    function isJudge() {
      return isAuthenticated() && (
        (userDocExists() && getUserData().role == 'judge') ||
        request.auth.token.role == 'judge'
      );
    }

    // Users Collection: each user can read their own profile; Admin can read and write all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Public / Reference collections
    match /classes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /teams/{id} { allow read: if true; allow write: if isAdmin(); }
    match /sections/{id} { allow read: if true; allow write: if isAdmin(); }
    match /fields/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /summits/{id} { allow read: if true; allow write: if isAdmin(); }
    match /programs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /programLibrary/{id} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /certificates/{id} { allow read: if true; allow write: if isAdmin(); }
    match /reportHistory/{id} { allow read: if true; allow write: if isAdmin(); }

    // Students: Admin full access; Leaders can manage their own team members; Everyone can read
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin() || (isLeader() && (!('teamId' in request.resource.data) || (userDocExists() && request.resource.data.teamId == getUserData().teamId)));
    }

    // Entries: Admin full access; Leaders can create/update entries for own team
    match /entries/{entryId} {
      allow read: if true;
      allow create, update: if isAdmin() || isLeader();
      allow delete: if isAdmin();
    }

    // Marks: Admin full access; Leaders marks upload (create only); Judges can score; Students read published
    match /marks/{markId} {
      allow read: if true;
      allow create: if isAdmin() || isJudge() || isLeader();
      allow update: if isAdmin() || isJudge();
      allow delete: if isAdmin();
    }

    // Attendance: Admin full access; Leaders record attendance for their team
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if isAdmin() || isLeader();
      allow delete: if isAdmin();
    }

    // Notifications & Audit Logs
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /judges/{judgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catch-all fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
